# ────────────────────────────────────────────────────────────────────────
# Production environment template for this new-api fork (PaaS deploys).
# Copy values into your Railway / Render dashboard — do NOT commit real
# secrets to the repo.
# ────────────────────────────────────────────────────────────────────────

# HTTP port (both platforms expect the app to listen on this).
PORT=3000

# ── Admin bootstrap (consumed by setup.sh on first boot) ────────────────
# Username: max 12 characters. Password: 8–128 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong
# self | demo | external — mirrors the setup wizard's "usage mode" step.
SETUP_MODE=self
# Internal address setup.sh polls; leave as default on Railway/Render.
SETUP_BASE_URL=http://127.0.0.1:3000
# Set to 1 to disable auto-bootstrap entirely (then use /setup manually).
# SETUP_SKIP=0

# ── Security (REQUIRED) ─────────────────────────────────────────────────
# Persistent session secret. Generate with:  openssl rand -hex 32
# Multi-node note: every node must share the same value.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# After you put the console behind HTTPS, switch these on:
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://your-app.up.railway.app,https://your-app.onrender.com

# ── Database ────────────────────────────────────────────────────────────
# Default (unset SQL_DSN) is SQLite at /data — perfect with a persistent
# volume. Switch to Postgres/MySQL by setting SQL_DSN instead.
SQLITE_PATH=/data/new-api.db
# SQL_DSN=postgres://user:pass@host:5432/newapi

# ── Behaviour ───────────────────────────────────────────────────────────
# Default UI/response language: en | zh-CN | zh-TW
DEFAULT_LANGUAGE=en
TZ=Asia/Kolkata
GENERATE_DEFAULT_TOKEN=true
ENABLE_PPROF=false
DEBUG=false
ERROR_LOG_ENABLED=true

# ── Trusted proxies ─────────────────────────────────────────────────────
# Railway/Render sit behind their own edge proxies; keep the defaults or
# list your platform's proxy CIDRs if you front it with Cloudflare etc.
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
